{
  "functions": {
    "api/index.py": {
      "runtime": "python3.9",
      "maxDuration": 10
    },
    "node-api/stream.js": {
      "runtime": "nodejs18.x",
      "maxDuration": 30
    }
  },
  "routes": [
    {
      "src": "/v1/chat/completions",
      "methods": ["POST"],
      "dest": "/node-api/stream.js",
      "headers": {
        "Cache-Control": "no-cache"
      }
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.py"
    }
  ]
}
